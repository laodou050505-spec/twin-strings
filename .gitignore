# Unity 生成 / 缓存（可由 Unity 重新生成）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/Assets/_Recovery/
/Assets/_Recovery.meta

# 打包产物（安装包不进仓库）
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab

# 美术原始素材：只收录体积小、说明设定用的部分
#   charref   六只木偶的设定图
#   Concept   阵容概念图
#   specs.json  P2 部件流水线的每件配置（面数上限等）
# P2 建模中间文件、参考图、历代界面生成稿体积大且不参与打包，不入库（游戏用到的成品都在 Assets 里）
/ArtSource/*
!/ArtSource/charref/
!/ArtSource/Concept/
!/ArtSource/specs.json
#   Brand     公司标志原件（官方 TRIPO 横版标志黑 / 白、图标），标题页出品签的贴图由黑字版衬到纸色上得到
!/ArtSource/Brand/

# 配音：只收录定稿原声（out/pinned，用户试听通过的版本）与音色表；
# 候选版本、挑选中间文件、试听页都能由脚本重新生成，不入库（成品在 Assets/_Brawl/Resources/Voice）
/Tools/voice/out/*
!/Tools/voice/out/pinned/
!/Tools/voice/out/voices.json
/Tools/voice/listen.html

# Python 缓存
__pycache__/
*.pyc

# IDE / 系统
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
